# Copy this file to `.env` and fill in local values.
# Tokens are used for authentication only and must never appear in logs.

# ========== 模型来源：auto / hf / modelscope ==========
MODEL_SOURCE=auto
# CLI --source overrides this. Omit the flag to honor MODEL_SOURCE.
# AutoDL / mainland networks: MODEL_SOURCE_PRIORITY=modelscope,hf
MODEL_SOURCE_PRIORITY=hf,modelscope

# ========== 通用模型标识 ==========
# Used by both sources when HF_MODEL_ID / MODELSCOPE_MODEL_ID are empty.
MODEL_ID=Qwen/Qwen2.5-7B-Instruct
MODEL_OUTPUT_NAME=Qwen2.5-7B-Instruct

# ========== Hugging Face ==========
HF_MODEL_ID=Qwen/Qwen2.5-7B-Instruct
HF_REVISION=main
HF_TOKEN=
HF_ENDPOINT=https://huggingface.co
HF_HUB_ENABLE_HF_TRANSFER=0

# ========== ModelScope ==========
MODELSCOPE_MODEL_ID=Qwen/Qwen2.5-7B-Instruct
MODELSCOPE_REVISION=master
MODELSCOPE_API_TOKEN=
MODELSCOPE_ENDPOINT=

# ========== 本地路径 ==========
DOWNLOAD_DIR=./models
MODEL_DIR=./models/base

# ========== vLLM ==========
# Bind address/port for this toolchain. They are passed as --host/--port and
# stripped from the vLLM child env (vLLM 0.29 warns on unknown VLLM_* vars).
VLLM_HOST=0.0.0.0
VLLM_PORT=8000
VLLM_API_KEY=sk-local
VLLM_SERVED_MODEL_NAME=
TENSOR_PARALLEL_SIZE=1
GPU_MEMORY_UTILIZATION=0.9
MAX_MODEL_LEN=4096
DTYPE=auto
QUANTIZATION=
VLLM_TRUST_REMOTE_CODE=1
VLLM_MAX_NUM_SEQS=16
VLLM_HEALTH_TIMEOUT=600
# 0 = skip FlashInfer sampler JIT (needed on native Windows if ninja/MSVC is missing)
VLLM_USE_FLASHINFER_SAMPLER=0
# Windows vLLM backends:
#   wsl     recommended; run the same command inside WSL2
#   docker  docker compose up vllm
#   native  unofficial community Windows wheel (vllm-windows); `import vllm` must already work
#   auto    native if import works, else WSL2, else Docker
#   fail    do not redirect; print the install hint and exit
# Optional helper: uv run python scripts/install_vllm_windows.py --check
VLLM_WINDOWS_BACKEND=wsl

# Serving engine: auto (vLLM if architecture looks supported or Spark plugin is in THIS env)
# vllm = force vLLM; hf = transformers OpenAI-compatible fallback (Windows-friendly)
# Spark plugin must be installed with uv pip into .venv. System/conda installs are ignored.
# VLLM_SPARK_PLUGIN=1 forces auto to treat Spark as vLLM-capable.
INFER_ENGINE=auto

# Spark chat template thinking. 1/true/on enables <think> for HF/OpenAI extra_body default.
ENABLE_THINKING=0
VLLM_SPARK_PLUGIN=
VLLM_TOOL_CALL_PARSER=
VLLM_ENABLE_AUTO_TOOL_CHOICE=0
LICENSE_STRICT=0
CONFIG_STRICT=0
EVAL_OUTPUT_DIR=./logs/eval

# ========== 训练后模型 ==========
CHECKPOINT_PATH=./training/output
BASE_MODEL=./models/base
ADAPTER_PATH=./training/output
TRAINED_MODEL_MODE=auto
TRAINED_LORA_NAME=trained
MERGED_MODEL_DIR=./training/output/merged

# ========== 日志与进程 ==========
LOG_DIR=./logs
PID_DIR=./run
